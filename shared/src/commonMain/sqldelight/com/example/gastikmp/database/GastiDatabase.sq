
-- ============================================================
-- BASE DE DATOS GASTI KMP
-- USUARIOS, GASTOS, INGRESOS Y CATEGORIAS
-- ============================================================


-- ============================================================
-- TABLA: USUARIO
-- Almacena las cuentas registradas.
-- Nunca guardar contraseñas en texto plano.
-- ============================================================

CREATE TABLE Usuario (
    email TEXT NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    password_hash TEXT NOT NULL,
    password_salt TEXT NOT NULL
);


-- ============================================================
-- TABLA: CATEGORIA
-- ============================================================

CREATE TABLE Categoria (
    id TEXT NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    usuario_email TEXT NOT NULL
);


-- ============================================================
-- TABLA: GASTO
-- ============================================================

CREATE TABLE Gasto (
    id TEXT NOT NULL PRIMARY KEY,
    usuario_email TEXT NOT NULL,
    descripcion TEXT NOT NULL,
    monto REAL NOT NULL,
    fecha TEXT NOT NULL,
    categoria_id TEXT NOT NULL,
    FOREIGN KEY (categoria_id) REFERENCES Categoria(id)
);


-- ============================================================
-- TABLA: TRANSACCION
-- ALMACENA GASTOS E INGRESOS
-- ============================================================

CREATE TABLE Transaccion (
    id TEXT NOT NULL PRIMARY KEY,
    usuario_email TEXT NOT NULL,
    descripcion TEXT NOT NULL,
    monto REAL NOT NULL,
    fecha TEXT NOT NULL,
    categoria_id TEXT NOT NULL,
    tipo TEXT NOT NULL CHECK(tipo IN ('GASTO', 'INGRESO')),
    FOREIGN KEY (categoria_id) REFERENCES Categoria(id)
);


-- ============================================================
-- CONSULTAS PARA USUARIOS
-- ============================================================

-- Registrar un usuario nuevo.
insertarUsuario:
INSERT INTO Usuario (
    email,
    nombre,
    password_hash,
    password_salt
)
VALUES (?, ?, ?, ?);


-- Buscar un usuario por su correo.
obtenerUsuarioPorEmail:
SELECT *
FROM Usuario
WHERE email = ?;


-- Comprobar si existe una cuenta.
existeUsuario:
SELECT COUNT(*)
FROM Usuario
WHERE email = ?;


-- Actualizar el nombre del usuario.
actualizarNombreUsuario:
UPDATE Usuario
SET nombre = ?
WHERE email = ?;


-- ============================================================
-- CONSULTAS PARA CATEGORIAS
-- ============================================================

-- Registrar una categoria.
insertarCategoria:
INSERT INTO Categoria (
    id,
    nombre,
    usuario_email
)
VALUES (?, ?, ?);


-- Obtener categorias de un usuario.
obtenerCategoriasPorUsuario:
SELECT *
FROM Categoria
WHERE usuario_email = ?;


-- Eliminar una categoria de un usuario.
eliminarCategoria:
DELETE FROM Categoria
WHERE id = ?
AND usuario_email = ?;


-- ============================================================
-- CONSULTAS PARA GASTOS
-- ============================================================

-- Registrar un gasto.
insertarGasto:
INSERT INTO Gasto (
    id,
    usuario_email,
    descripcion,
    monto,
    fecha,
    categoria_id
)
VALUES (?, ?, ?, ?, ?, ?);


-- Obtener gastos de un usuario.
obtenerGastosPorUsuario:
SELECT *
FROM Gasto
WHERE usuario_email = ?
ORDER BY fecha DESC;


-- Obtener un gasto por identificador.
obtenerGastoPorId:
SELECT *
FROM Gasto
WHERE id = ?
AND usuario_email = ?;


-- Actualizar un gasto.
actualizarGasto:
UPDATE Gasto
SET
    descripcion = ?,
    monto = ?,
    fecha = ?,
    categoria_id = ?
WHERE id = ?
AND usuario_email = ?;


-- Eliminar un gasto.
eliminarGasto:
DELETE FROM Gasto
WHERE id = ?
AND usuario_email = ?;


-- ============================================================
-- CONSULTAS PARA TRANSACCIONES
-- ============================================================

-- Registrar una transaccion.
insertarTransaccion:
INSERT INTO Transaccion (
    id,
    usuario_email,
    descripcion,
    monto,
    fecha,
    categoria_id,
    tipo
)
VALUES (?, ?, ?, ?, ?, ?, ?);


-- Obtener transacciones de un usuario.
obtenerTransaccionesPorUsuario:
SELECT *
FROM Transaccion
WHERE usuario_email = ?
ORDER BY fecha DESC;


-- Obtener una transaccion por identificador.
obtenerTransaccionPorId:
SELECT *
FROM Transaccion
WHERE id = ?
AND usuario_email = ?;


-- Actualizar una transaccion.
actualizarTransaccion:
UPDATE Transaccion
SET
    descripcion = ?,
    monto = ?,
    fecha = ?,
    categoria_id = ?,
    tipo = ?
WHERE id = ?
AND usuario_email = ?;


-- Eliminar una transaccion.
eliminarTransaccion:
DELETE FROM Transaccion
WHERE id = ?
AND usuario_email = ?;
