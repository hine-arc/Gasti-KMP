-- ============================================================
-- BASE DE DATOS GASTI
-- MÓDULO DE GASTOS, INGRESOS Y CATEGORÍAS
-- ============================================================


-- ============================================================
-- TABLA: CATEGORIA
-- ============================================================

CREATE TABLE Categoria (
    id TEXT NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    usuario_email TEXT NOT NULL
);


-- ============================================================
-- TABLA: GASTO
-- ============================================================

CREATE TABLE Gasto (
    id TEXT NOT NULL PRIMARY KEY,
    usuario_email TEXT NOT NULL,
    descripcion TEXT NOT NULL,
    monto REAL NOT NULL,
    fecha TEXT NOT NULL,
    categoria_id TEXT NOT NULL,
    FOREIGN KEY (categoria_id) REFERENCES Categoria(id)
);


-- ============================================================
-- TABLA: TRANSACCION
-- ALMACENA GASTOS E INGRESOS
-- ============================================================

CREATE TABLE Transaccion (
    id TEXT NOT NULL PRIMARY KEY,
    usuario_email TEXT NOT NULL,
    descripcion TEXT NOT NULL,
    monto REAL NOT NULL,
    fecha TEXT NOT NULL,
    categoria_id TEXT NOT NULL,
    tipo TEXT NOT NULL CHECK(tipo IN ('GASTO', 'INGRESO')),
    FOREIGN KEY (categoria_id) REFERENCES Categoria(id)
);


-- ============================================================
-- CONSULTAS PARA CATEGORIAS
-- ============================================================

-- Registrar una categoría.
insertarCategoria:
INSERT INTO Categoria (
    id,
    nombre,
    usuario_email
)
VALUES (?, ?, ?);


-- Obtener categorías de un usuario.
obtenerCategoriasPorUsuario:
SELECT *
FROM Categoria
WHERE usuario_email = ?;


-- Eliminar una categoría de un usuario.
eliminarCategoria:
DELETE FROM Categoria
WHERE id = ?
AND usuario_email = ?;


-- ============================================================
-- CONSULTAS PARA GASTOS
-- ============================================================

-- Registrar un gasto.
insertarGasto:
INSERT INTO Gasto (
    id,
    usuario_email,
    descripcion,
    monto,
    fecha,
    categoria_id
)
VALUES (?, ?, ?, ?, ?, ?);


-- Obtener gastos de un usuario.
obtenerGastosPorUsuario:
SELECT *
FROM Gasto
WHERE usuario_email = ?
ORDER BY fecha DESC;


-- Obtener un gasto por identificador.
obtenerGastoPorId:
SELECT *
FROM Gasto
WHERE id = ?
AND usuario_email = ?;


-- Actualizar un gasto.
actualizarGasto:
UPDATE Gasto
SET
    descripcion = ?,
    monto = ?,
    fecha = ?,
    categoria_id = ?
WHERE id = ?
AND usuario_email = ?;


-- Eliminar un gasto.
eliminarGasto:
DELETE FROM Gasto
WHERE id = ?
AND usuario_email = ?;


-- ============================================================
-- CONSULTAS PARA TRANSACCIONES
-- ============================================================

-- Registrar una transacción.
insertarTransaccion:
INSERT INTO Transaccion (
    id,
    usuario_email,
    descripcion,
    monto,
    fecha,
    categoria_id,
    tipo
)
VALUES (?, ?, ?, ?, ?, ?, ?);


-- Obtener transacciones de un usuario.
obtenerTransaccionesPorUsuario:
SELECT *
FROM Transaccion
WHERE usuario_email = ?
ORDER BY fecha DESC;


-- Obtener una transacción por identificador.
obtenerTransaccionPorId:
SELECT *
FROM Transaccion
WHERE id = ?
AND usuario_email = ?;


-- Actualizar una transacción.
actualizarTransaccion:
UPDATE Transaccion
SET
    descripcion = ?,
    monto = ?,
    fecha = ?,
    categoria_id = ?,
    tipo = ?
WHERE id = ?
AND usuario_email = ?;


-- Eliminar una transacción.
eliminarTransaccion:
DELETE FROM Transaccion
WHERE id = ?
AND usuario_email = ?;